        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "10.4.0",
      "title": "Endpoint Performance",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"${job}\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"${job}\"}[5m])) by (uri)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "Avg Response Time"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"${job}\"}[5m])) by (uri)",
          "format": "table",
          "hide": false,
          "instant": true,
          "range": false,
          "refId": "B",
          "legendFormat": "Requests/sec"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"${job}\", status=~\"4..|5..\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"${job}\"}[5m])) by (uri)",
          "format": "table",
          "hide": false,
          "instant": true,
          "range": false,
          "refId": "C",
          "legendFormat": "Error %"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "uri",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
            },
            "renameByName": {
              "Value": "Avg Response Time (s)",
              "Value #B": "Requests/sec",
              "Value #C": "Error %",
              "uri": "Endpoint"
            }
          }
        }
      ]
    },
