      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"${job}\"}[1m])) by (uri)",
          "instant": false,
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
