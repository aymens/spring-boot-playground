        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{job=\"${job}\"}) / sum(jvm_memory_max_bytes{job=\"${job}\"}) * 100",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ]
    },
